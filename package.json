{
  "name": "node-onlykey-lib",
  "version": "0.4.0",
  "description": "The OnlyKey client protocol, in JavaScript. One library, any GUI - Node, nw.js, the browser and React Native.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "onlykey-js": "cli/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./bytes": "./src/bytes.js",
    "./protocol": "./src/protocol/index.js",
    "./transport": "./src/transport/index.js",
    "./transport/webauthn": "./src/transport/webauthn.js",
    "./device": "./src/device/index.js",
    "./keychain": "./src/keychain/index.js",
    "./device/press": "./src/device/press.js",
    "./device/version": "./src/device/version.js",
    "./device/preferences": "./src/device/preferences.js",
    "./versions": "./src/versions/index.js",
    "./crypto": "./src/crypto/index.js",
    "./crypto/pgp": "./src/crypto/pgp.js",
    "./vendor/openpgp": "./src/vendor/openpgp/openpgp.js",
    "./vendor/@noble/*": "./src/vendor/exports/@noble/*",
    "./vendor/tweetnacl": "./src/vendor/exports/tweetnacl.js",
    "./plugins/host": "./plugins/host/index.js",
    "./plugins/session": "./plugins/session/index.js",
    "./plugins/transport/memory": "./plugins/transport/memory.js",
    "./plugins/transport/embedded": "./plugins/transport/embedded.js",
    "./plugins/transport/usb": "./plugins/transport/usb.js",
    "./plugins/transport/ble": "./plugins/transport/ble.js",
    "./plugins/transport/tunnel": "./plugins/transport/tunnel.js",
    "./plugins/device": "./plugins/device/index.js",
    "./plugins/okcrypto": "./plugins/okcrypto/index.js",
    "./browser": "./plugins/browser.js",
    "./cli/desktop": "./cli/desktop.js",
    "./cli/firmware-plugins": "./cli/firmware-plugins.js",
    "./bundler-aliases": "./scripts/bundler-aliases.js",
    "./package.json": "./package.json",
    "./webcrypto": "./src/webcrypto/subtle.js",
    "./webcrypto/text": "./src/webcrypto/text.js"
  },
  "files": [
    "src",
    "plugins",
    "cli",
    "scripts",
    "tsconfig.json",
    "FINDINGS.md",
    "FINDING-*.md"
  ],
  "scripts": {
    "test": "npm run types && node --test test/*.test.js",
    "types": "node scripts/gen-types.js"
  },
  "dependencies": {
    "@bmatusiak/rectify": "github:bmatusiak/rectify#a0d9f0e6e537053122273b1f763ac87ae461361c"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "node-hid": "^3.4.0",
    "@stoprocent/noble": "2.8.0",
    "dbus-next": "^0.10.2"
  },
  "peerDependenciesMeta": {
    "node-hid": {
      "optional": true
    },
    "@stoprocent/noble": {
      "optional": true
    },
    "dbus-next": {
      "optional": true
    }
  }
}
