{
  "name": "node-onlykey-lib",
  "version": "0.1.0",
  "description": "The OnlyKey client protocol, in JavaScript. One library, any GUI - Node, nw.js, the browser and React Native.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./bytes": "./src/bytes.js",
    "./protocol": "./src/protocol/index.js",
    "./transport": "./src/transport/index.js",
    "./device": "./src/device/index.js",
    "./crypto": "./src/crypto/index.js",
    "./crypto/pgp": "./src/crypto/pgp.js",
    "./plugins/host": "./plugins/host/index.js",
    "./plugins/session": "./plugins/session/index.js",
    "./plugins/transport/memory": "./plugins/transport/memory.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "plugins",
    "scripts",
    "tsconfig.json",
    "FINDINGS.md",
    "FINDING-*.md"
  ],
  "scripts": {
    "test": "npm run types && node --test test/*.test.js",
    "types": "node scripts/gen-types.js"
  },
  "dependencies": {
    "@bmatusiak/rectify": "github:bmatusiak/rectify",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
