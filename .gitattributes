# The vendored openpgp fork is verified by checksum against two sibling copies
# (onlykey.github.io and python-onlykey), which are required to stay
# byte-identical to each other. This repo has core.autocrlf active, and a line
# -ending rewrite on checkout would change the file's bytes and break that
# check on every machine but the one that committed it. Keep it exactly as
# stored.
src/vendor/openpgp/openpgp.js -text

# The vendored npm packages are the published tarballs' bytes, recorded by a
# tree hash in src/vendor/VENDORED.json (scripts/vendor.js --check). Same
# reason as above: a checkout-time line-ending rewrite would fail that check.
src/vendor/node_modules/** -text
# The generated shims are compared byte-for-byte with what scripts/vendor.js
# writes (LF), so they must not be rewritten on checkout either.
src/vendor/exports/** -text

# The generated declarations (scripts/gen-types.js, `npm run types`) are
# written with LF. With core.autocrlf active, git expected CRLF in the working
# copy, so every regeneration showed all 60+ .d.ts files as modified with no
# content change. Declaring them LF makes git and the generator agree.
src/**/*.d.ts text eol=lf
